# cp .env.example .env 후 값 채우기. .env / .env.providers 는 절대 커밋하지 않는다.
COMPOSE_PROJECT_NAME=postiz
POSTIZ_IMAGE=ghcr.io/gitroomhq/postiz-app:latest
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.2

# 외부/내부에서 접속할 주소 (NAS IP 또는 도메인). 예: http://<NAS_IP>:<HOST_PORT>
POSTIZ_URL=
HOST_PORT=5000

# 데이터/백업 위치 (NAS 볼륨 경로로 지정)
DATA_DIR=./data
BACKUP_DIR=./backups
BACKUP_KEEP=14

DB_USER=postiz
DB_NAME=postiz
DB_PASSWORD=
JWT_SECRET=
# 첫 관리자 계정을 만든 뒤 true 로 바꿔 가입을 막는다
DISABLE_REGISTRATION=false
